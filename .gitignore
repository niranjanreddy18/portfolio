# ============================================================
# .gitignore — Portfolio Project (Django Backend + React Frontend)
# ============================================================


# ============================================================
# ENVIRONMENT & SECRETS — NEVER commit these
# ============================================================
.env
.env.local
.env.development
.env.production
.env.*.local
backend/.env
frontend/.env


# ============================================================
# PYTHON / DJANGO
# ============================================================

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environment
venv/
.venv/
env/
ENV/
.env/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/db.sqlite3

# Django collected static & media (generated at deploy time)
backend/staticfiles/
backend/media/

# Django migrations (optional — keep if working solo, exclude if team)
# backend/api/migrations/   ← leave commented out; migrations should be committed

# Pytest / testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST


# ============================================================
# NODE.JS / REACT / VITE
# ============================================================

# Dependencies — always regenerated with npm install
node_modules/
frontend/node_modules/

# Vite production build output
frontend/dist/
frontend/dist-ssr/

# Vite cache
frontend/.vite/
.vite/

# npm / yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Parcel cache (if ever used)
.cache/
.parcel-cache/


# ============================================================
# DOCKER
# ============================================================
# Docker override files (local-only overrides)
docker-compose.override.yml

# Docker volumes are managed externally — not tracked
# (postgres_data, media_files are Docker named volumes)


# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ============================================================
# CODE EDITORS & IDEs
# ============================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# ============================================================
# MISCELLANEOUS
# ============================================================

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Coverage reports
coverage/
*.lcov

# TypeScript build info (if added later)
*.tsbuildinfo
