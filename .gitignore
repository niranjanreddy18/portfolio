# ============================================================
# .gitignore — Portfolio Project (Django Backend + React Frontend)
# ============================================================

# ============================================================
# ENVIRONMENT & SECRETS — NEVER commit these
# ============================================================
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local

# Ensure .env.example files are NEVER ignored
!.env.example
!**/.env.example
!.env*.example
!**/.env*.example


# ============================================================
# PYTHON / DJANGO
# ============================================================

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Django specific
*.log
local_settings.py
*.sqlite3
db.sqlite3
db.sqlite3-journal
backend/db.sqlite3

# Django collected static & media (generated at deploy time / uploads)
staticfiles/
backend/staticfiles/
media/
backend/media/

# Pytest / testing & code coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST


# ============================================================
# NODE.JS / REACT / VITE
# ============================================================

# Dependencies — always regenerated with npm install
node_modules/
frontend/node_modules/

# Production build outputs
dist/
build/
frontend/dist/
frontend/dist-ssr/

# Vite cache
.vite/
frontend/.vite/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Parcel cache (if ever used)
.cache/
.parcel-cache/


# ============================================================
# DOCKER
# ============================================================
# Docker override files (local-only overrides)
docker-compose.override.yml


# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ============================================================
# CODE EDITORS & IDEs
# ============================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# ============================================================
# TEMPORARY & BACKUP FILES / LOGS
# ============================================================
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Coverage reports
coverage/
*.lcov

# TypeScript build info (if added later)
*.tsbuildinfo
