# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (Production uses Neon PostgreSQL via DATABASE_URL; falls back to SQLite if empty)
# Neon connection string format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=
# Set to True to force local SQLite even if DATABASE_URL is set
USE_SQLITE=True
CONN_MAX_AGE=600

# CORS - comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourfrontend.com

# Email (Resend API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev during testing or your verified domain in production
DEFAULT_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=your@email.com
# Backward compatibility aliases
CONTACT_EMAIL=your@email.com

# Logging
DJANGO_LOG_LEVEL=INFO
