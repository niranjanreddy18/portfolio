# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL)
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Set to True to use SQLite (dev only)
USE_SQLITE=False

# CORS - comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourfrontend.com

# Email (SMTP or console for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourportfolio.dev
CONTACT_EMAIL=hello@yourname.dev

# Logging
DJANGO_LOG_LEVEL=INFO
